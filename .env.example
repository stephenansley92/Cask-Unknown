# Public browser-safe Supabase configuration. Never put a secret/service-role
# key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Local database administration only. Do not expose this value to Next.js and
# do not commit it. The schema preflight script reads it from the shell.
# SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres
